# Copy to .env and fill in. Never commit .env.

# App
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Database and Redis (docker compose binds both to 127.0.0.1 only)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://app:change-me@127.0.0.1:5432/autoschedule
REDIS_URL=redis://127.0.0.1:6379

# 32-byte key, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Leave SMTP_HOST empty in development to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="YourBrand <no-reply@example.com>"

# Uploaded media is served from this separate origin (S3, R2 or a CDN), never from APP_URL.
MEDIA_PUBLIC_URL=

# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For you trust.
TRUSTED_PROXIES=
