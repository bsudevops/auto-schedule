# Copy to .env and fill in. Never commit .env.

# App
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Database and Redis (docker compose binds both to 127.0.0.1 only)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://app:change-me@127.0.0.1:5432/autoschedule
REDIS_URL=redis://127.0.0.1:6379

# 32-byte key, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Leave SMTP_HOST empty in development to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BSU Scheduler <no-reply@example.com>"

# Who can create an account. "open" (default) lets anyone. "invite-only" closes the sign-up page: people join only
# through an invitation sent from inside the app. Addresses in ADMIN_EMAILS (comma-separated) can always sign up.
# Create the first admin without email with: npm run admin:create -- --email you@company.com --name "Your Name"
SIGNUP_MODE=open
ADMIN_EMAILS=

# Uploaded media is served from this separate origin (S3, R2 or a CDN), never from APP_URL.
MEDIA_PUBLIC_URL=http://localhost:3001

# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For you trust.
TRUSTED_PROXIES=

# Media storage: "local" (development, served by `npm run media`) or "s3" (S3, R2 or compatible)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Hosting on Vercel (see docs/VERCEL.md)
# CRON_SECRET: any long random string. Vercel sends it with each scheduled job; without it the jobs stay off.
CRON_SECRET=
# On Vercel the scheduled jobs replace the worker automatically. Set to "queue" to force the worker, or "inline" to force the jobs.
JOBS_MODE=
# Supabase or another pooler: use its pooled address for DATABASE_URL (port 6543) and the direct/session address here, used only to run migrations.
DATABASE_URL_MIGRATE=
# Prepared statements are turned off automatically for port 6543. Set true or false to override.
DATABASE_POOLED=
# Connections each server instance keeps (default 3 on Vercel, 10 elsewhere).
DB_POOL_MAX=

# Background worker
# Set to "true" to try the product without platform apps: posts are marked published but nothing is sent. Ignored on any non-localhost production URL.
PUBLISH_DRY_RUN=false
WORKER_CONCURRENCY=5

# Social platforms. Create an app on each developer portal and set its redirect URL to
#   {APP_URL}/api/channels/callback/{meta|linkedin|tiktok|threads|youtube|google_business|pinterest|mastodon}
# Bluesky, Mastodon and DEV.to need nothing here. See docs/PLATFORM-SETUP.md.
# Facebook Pages and Instagram (developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# LinkedIn (linkedin.com/developers). Add "w_organization_social r_organization_social rw_organization_admin"
# to the scopes once the app has the Community Management API, to post to company pages.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES="openid profile w_member_social"
LINKEDIN_API_VERSION=202410
# TikTok (developers.tiktok.com). Verify the MEDIA_PUBLIC_URL domain there so TikTok can fetch videos.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
# Threads (developers.facebook.com, "Access the Threads API" use case). Its own ID and secret.
THREADS_APP_ID=
THREADS_APP_SECRET=
# YouTube and Google Business Profile (console.cloud.google.com, one OAuth client for both)
GOOGLE_PUBLISH_CLIENT_ID=
GOOGLE_PUBLISH_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=public
# Pinterest (developers.pinterest.com). Use the sandbox until Standard access is approved.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_SANDBOX=false

# REST API: requests per key per minute
API_RATE_LIMIT_PER_MINUTE=120
# Local development only: let webhooks reach http:// and private addresses. Ignored in production.
WEBHOOK_ALLOW_PRIVATE=false

# Optional composer extras. Leave empty to hide them.
# Writing help (console.anthropic.com). ANTHROPIC_MODEL defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Free stock photo search (pexels.com/api)
PEXELS_API_KEY=

# Writing from media: Gemini looks at a post's image, carousel or video and suggests captions, YouTube titles
# and hashtags (aistudio.google.com/apikey). Also powers writing help when ANTHROPIC_API_KEY is empty.
# GEMINI_MODEL defaults to gemini-3.8-flash.
GEMINI_API_KEY=
GEMINI_MODEL=
# Backup models, comma-separated, used straight away when the main one is overloaded. Empty: picked from the Flash models your key can use.
GEMINI_FALLBACK_MODELS=
